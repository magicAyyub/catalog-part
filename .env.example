# ─── app-etf : traduction immatriculation → K-Type ────────────────────────────
# app-etf est déployé et maintenu séparément (https://etf.jumbopneus.shop).
# Son seul rôle ici : rendre le K-Type TecDoc d'une plaque, qui est exactement
# le `vehicleId` attendu par les endpoints RapidAPI. Tout le catalogue vient
# ensuite de RapidAPI/TecDoc.
# Le token est de type "shell", à créer sur /admin/tokens d'app-etf.
ETF_API_URL=https://etf.jumbopneus.shop/api/external/by-plate
ETF_API_TOKEN=

# Délai max d'attente, en ms. app-etf scrape les produits avant de répondre
# (8-18 s à froid), même si on ne garde que l'en-tête véhicule.
ETF_API_TIMEOUT_MS=90000

# ─── RapidAPI / TecDoc ────────────────────────────────────────────────────────
RAPIDAPI_KEY=
BASE_URL=https://auto-parts-catalog.p.rapidapi.com
LANG_ID=6
COUNTRY_FILTER_ID=63
TYPE_ID=1

# Serveur de fixtures, pour développer sans consommer d'appels facturés.
USE_MOCK_API=false
MOCK_BASE_URL=http://localhost:4000

# Durée de vie du cache véhicule, en jours. Passé ce délai, un véhicule consulté
# est resynchronisé (~10 appels).
SYNC_TTL_DAYS=180

# Catégories TecDoc synchronisées.
# 100030 = Plaquettes de frein, 100032 = Disques de frein
ALLOWED_CATEGORY_IDS=100030,100032

# ─── Équipementiers retenus — LEVIER DE COÛT DIRECT ───────────────────────────
# Chaque équipementier de cette liste coûte UN appel « critères » par catégorie
# et par véhicule. C'est le poste le plus lourd d'une synchronisation :
#     5 marques → 10 appels/véhicule      3 marques → 6 appels/véhicule
# TecDoc renvoie ~500 articles par catégorie ; ce filtre les ramène à ~15-30.
# ETF=7657, TRW=161, BOSCH=30, VALEO=21, TEXTAR=39
ALLOWED_SUPPLIER_IDS_PROD=7657,161,30,21,39

# Équivalent en mode mock (IDs du serveur de fixtures)
ALLOWED_SUPPLIER_IDS_MOCK=2,8,12

# ─── Pré-chauffage nocturne (pnpm warm:vehicles) ──────────────────────────────
# Renouvelle les véhicules dont le cache expire dans moins de N jours.
WARM_REFRESH_DAYS=30
# Plafond par exécution, pour ne jamais épuiser le quota d'un coup.
WARM_MAX_VEHICLES=50
# Pause entre véhicules (l'API limite les requêtes par seconde).
WARM_DELAY_MS=1500

# ─── Base locale ──────────────────────────────────────────────────────────────
SQLITE_PATH=./data/app.db

# ─── Import tarifs WinPro (endpoint admin) ────────────────────────────────────
ADMIN_API_TOKEN=