# RapidAPI / TecDoc
RAPIDAPI_KEY=
BASE_URL=https://auto-parts-catalog.p.rapidapi.com
LANG_ID=6
COUNTRY_FILTER_ID=63
TYPE_ID=1

# Base locale
SQLITE_PATH=./data/app.db

# Durée de vie du cache véhicule, en jours. Passé ce délai, un véhicule consulté
# est resynchronisé, environ 10 appels.
SYNC_TTL_DAYS=180

# Catégories TecDoc synchronisées.
# 100030 = Plaquettes de frein, 100032 = Disques de frein
ALLOWED_CATEGORY_IDS=100030,100032

# Équipementiers retenus, levier de coût le plus direct.
# Chaque équipementier coûte un appel « critères » par catégorie et par véhicule :
# 5 marques font 10 appels par véhicule, 3 marques en font 6.
# TecDoc renvoie environ 500 articles par catégorie, ce filtre les ramène à 15-30.
# ETF=7657, TRW=161, BOSCH=30, VALEO=21, TEXTAR=39
ALLOWED_SUPPLIER_IDS_PROD=7657,161,30,21,39

# Exadis, traduction plaque vers K-Type
# Seule donnée prélevée chez un fournisseur : le K-Type. Aucun prix, aucun stock,
# aucun article. Sans ces identifiants, la recherche par plaque est hors service
# et il reste la sélection marque / modèle / motorisation.
EXADIS_USERNAME=
EXADIS_PASSWORD=
EXADIS_SESSION_TTL_MINUTES=20
EXADIS_TIMEOUT_MS=20000

# Pré-chauffage des véhicules dont le cache approche de l'expiration
WARM_REFRESH_DAYS=30
WARM_MAX_VEHICLES=50
# Pause entre véhicules, l'API limite les requêtes par seconde.
WARM_DELAY_MS=1500

# Préparation nocturne
# Plafond dur d'appels facturés par exécution, compté sur les appels réels.
NIGHT_MAX_API_CALLS=60
# Sauvegardes conservées dans data/backups.
NIGHT_BACKUPS_KEPT=7

# Page de trace /logs
# Mot de passe distinct des comptes franchisés : la trace montre les plaques
# consultées et les appels facturés. Vide, la page reste fermée pour tout le monde.
LOGS_PASSWORD=
LOGS_UNLOCK_TTL_HOURS=12

# Gestion des comptes /comptes
# Mot de passe distinct des comptes franchisés : cette page crée et révoque
# les accès. Vide, la page reste fermée pour tout le monde.
ADMIN_PASSWORD=
ADMIN_UNLOCK_TTL_HOURS=4

# Authentification
# Clé de signature des cookies de session, 32 caractères minimum.
# Générer avec : openssl rand -base64 48
# La changer déconnecte tout le monde, ce qui révoque toutes les sessions d'un coup.
AUTH_SECRET=
# Durée de vie d'une session, en jours. Les postes en concession sont partagés,
# d'où une valeur courte.
AUTH_SESSION_TTL_DAYS=7
