{
  "name": "catalog-part",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "concurrently --names 'fixture,next' --prefix-colors 'cyan,green' 'npm start --prefix fixture-server' 'next dev'",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:user": "tsx --env-file=.env scripts/manage-user.ts",
    "sync:vehicle": "tsx --env-file=.env scripts/sync-vehicle.ts",
    "warm:vehicles": "tsx --env-file=.env scripts/warm-vehicles.ts",
    "vehicles:harvest": "tsx --env-file=.env scripts/harvest-vehicles.ts",
    "night:run": "tsx --env-file=.env scripts/night-run.ts",
    "index:braking": "tsx --env-file=.env scripts/index-braking.ts",
    "catalog:report": "tsx --env-file=.env scripts/coverage-report.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "better-sqlite3": "^13.0.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
